# Copy this file to the project root as .env (next to docker-compose.yml)
# and fill in real values. The backend also accepts a .env in backend/.
# Generate the three secrets with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# (use openssl rand -hex 32 for a plain hex string; JWT/API keys need >= 32 chars.)

# PostgreSQL connection (required)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://hisabpro:${POSTGRES_PASSWORD}@127.0.0.1:5432/hisabpro

# JWT signing secret (required, at least 32 random characters)
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Legacy shared API key kept for compatibility; routers use JWT + roles.
HISABPRO_API_KEY=change-me

# Base64-encoded 32-byte key for encrypting backups at rest (required
# when using docker compose; AES-256-GCM).
HISABPRO_BACKUP_KEY=change-me

# Backups older than this many days are pruned, keeping at least the
# newest KEEP_MIN files. Optional (defaults shown).
HISABPRO_BACKUP_RETENTION_DAYS=30
HISABPRO_BACKUP_KEEP_MIN=5

# Where backups are written (optional).
HISABPRO_BACKUP_DIR=~/hisabpro/backups

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Failed logins allowed per client+username per minute. 0 disables.
HISABPRO_LOGIN_RATE_LIMIT=10

# Logging: level always applies; file logging only when LOG_DIR is set.
HISABPRO_LOG_LEVEL=INFO
# HISABPRO_LOG_DIR=/var/log/hisabpro

# Offsite backup sync (optional, enable with --profile offsite).
# RCLONE_REMOTE=gdrive:snj-gold-lab-backups
# RCLONE_INTERVAL=86400
