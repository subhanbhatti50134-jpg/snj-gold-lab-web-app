# Copy this file to backend/.env and fill in real values.
# The backend also accepts a .env in the project root (one level up).

# PostgreSQL connection (required)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://hisabpro:${POSTGRES_PASSWORD}@127.0.0.1:5432/hisabpro

# JWT signing secret (required, at least 32 random characters)
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Legacy shared API key kept for compatibility; routers use JWT + roles.
HISABPRO_API_KEY=change-me

# Where pg_dump backups are written (optional).
HISABPRO_BACKUP_DIR=~/hisabpro/backups

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Failed logins allowed per client+username per minute. 0 disables.
HISABPRO_LOGIN_RATE_LIMIT=10
